---
import CSharp from "./img/CSharp.astro";
import DotNet from "./img/DotNet.astro";
import Mysql from "./img/Mysql.astro";
import PostgreSQL from "./img/PostgreSQL.astro";
import MongoDB from "./img/MongoDB.astro";
import RabbitMQ from "./img/RabbitMQ.astro";
import Docker from "./img/Docker.astro";
import Kubernetes from "./img/Kubernetes.astro";
import Rider from "./img/Rider.astro";
import Angular from "./img/Angular.astro";
import AstroIcon from "./img/AstroIcon.astro";
import Figma from "./img/Figma.astro";
import Prometheus from "./img/Prometheus.astro";
import Git from "./img/Git.astro";
---

<div
  class="flex flex-col text-black lg:max-w-[800px] justify-center items-center gap-8 mx-10 my-8"
>
  <h3 class="text-black font-semibold text-3xl self-start">
    &lt;Sobre mí /&gt;
  </h3>
  <div
    class="flex flex-col lg:max-w-[800px] lg:flex-row rounded-lg justify-center items-center"
  >
    <div
      class="flex flex-col justify-center items-center gap-2 lg:text-xl text-lg text-pretty text-black/90"
    >
      <p>
        Soy Sergio, <span class="font-medium"
          >un desarrollador Web autodidacta, amante de la tecnología, creativo y
          dedicado.</span
        > Busco constantemente aprender y <span class="font-medium"
          >enfrentar nuevos desafíos</span
        >.
      </p>
      <p>
        Además de mi pasión por la programación disfruto de viajar, asistir a
        eventos automovilísticos, realizar ciclismo por montaña y estar con la
        familia.
      </p>
    </div>
    <div
      class="flex flex-col items-center justify-center gap-2 lg:w-[800px] relative mt-4"
    >
      <img
        src="me.webp"
        alt="Mi imagen"
        loading="lazy"
        class="lg:w-52 lg:h-52 w-36 h-36 mb-4 rounded-sm absolute blur-xl"
      />
      <img
        src="me.webp"
        alt="Mi imagen"
        loading="lazy"
        class="lg:w-52 lg:h-52 w-36 h-36 rounded-lg z-10"
      />
      <p class="italic text-sm text-black/90 z-10">"In omnia paratus"</p>
    </div>
  </div>
  <div class="flex flex-row flex-grow gap-4 max-w-[300px] md:max-w-[400px]">
    <CSharp />
    <DotNet />
    <Mysql />
    <PostgreSQL />
    <MongoDB />
    <RabbitMQ />
    <Docker />
    <Kubernetes />
    <Rider />
    <Angular />
    <AstroIcon />
    <Figma />
    <Prometheus />
    <Git/>
  </div>

</div>
